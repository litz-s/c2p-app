<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.3" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.c2p.TableController"
            fx:id="root">
    <top>
        <HBox spacing="8" style="-fx-padding: 10;">
            <Button fx:id="backBtn" text="← 戻る" />
            <Label fx:id="titleLabel" style="-fx-font-size: 16; -fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search..." prefWidth="220"/>
            <Button fx:id="clearSearchBtn" text="✕" focusTraversable="false"/>
            <Button fx:id="addRowBtn" text="行を追加" />
        </HBox>
    </top>
    <center>
        <ListView fx:id="listView"/>
    </center>
</BorderPane>
